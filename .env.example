# Obrigatório: token do bot oficial que exibe o painel.
TOKEN_BOT_CONTROLE=

# Opcionais: canais onde as mensagens estáticas serão publicadas.
# Sem eles, o comando /painel continua disponível.
ID_CANAL_SOBRE=
ID_CANAL_PAINEL=

# Porta do keep-alive HTTP local/Render.
PORT=8080

# Obrigatórios para o painel web: é a única forma de entrar (login com Discord, OAuth2).
# O redirect precisa ser idêntico ao cadastrado no portal (OAuth2 > Redirects).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback
# Opcional: servidor em que quem entra com Discord é colocado (pede guilds.join).
# O bot de controle precisa estar nesse servidor com permissão de criar convite.
DISCORD_JOIN_GUILD_ID=

# Recomendado em produção: IDs do Discord que podem usar o site e o /painel, separados por vírgula.
# Vazio libera qualquer conta.
ALLOWED_USER_IDS=

# Produção atrás de proxy com HTTPS (Render, Cloudflare Tunnel, nginx).
# WEB_SESSION_SECRET: 32 caracteres ou mais. Sem ele, um aleatório a cada início.
WEB_SESSION_SECRET=
# 1 quando o HTTPS termina no proxy: cookie de sessão com Secure e HSTS.
WEB_FORCE_SECURE_COOKIE=
# IPs ou faixas de onde o proxy conecta. No Render: 127.0.0.1,::1,10.0.0.0/8
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Contas conectadas ao mesmo tempo (cada uma é um processo Python). Ajuste à memória do servidor.
MAX_ACTIVE_WORKERS=25
# DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO
